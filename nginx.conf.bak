server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip Compression - Enabled
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;
    gzip_disable "msie6";

    # Brotli Compression - Enabled (requires nginx with brotli module)
    brotli on;
    brotli_comp_level 6;
    brotli_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml font/truetype font/opentype;

    # 301 Redirects
    # Integration URL redirects
    rewrite ^/integrations/zoho-crm$ /zoho-whatsapp-integration permanent;
    rewrite ^/zoho-crm$ /zoho-whatsapp-integration permanent;
    rewrite ^/integrations/hubspot$ /hubspot-whatsapp-integration permanent;
    rewrite ^/hubspot$ /hubspot-whatsapp-integration permanent;
    # Portuguese blog redirects
    rewrite ^/br/blog/unlock-productivity-with-tasks-hubspot-whatsapp-integration$ /br/hubspot-whatsapp-integration permanent;
    rewrite ^/br/blog/integrate-hubspot-with-whatsapp-easiest-method$ /br permanent;
    # Fix /index.html SEO issue - redirect to root
    rewrite ^/index\.html$ / permanent;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Main location with performance headers
    location / {
        # Optimize TTFB - Disable access log for faster response
        access_log off;
        try_files $uri $uri/index.html $uri/ =404;
    }

    # Static Assets - Long caching for better LCP
    location ~* \.(js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Images with optimized caching
    location ~* \.(png|jpg|jpeg|gif|ico|webp|avif)$ {
        expires 6M;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # SVG and Fonts
    location ~* \.(svg|woff|woff2|ttf|eot|otf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # HTML files - Short cache for versioned assets
    location ~* \.html$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # Favicon - no cache
    location = /favicon.ico {
        access_log off;
        log_not_found off;
        expires -1;
    }

    # Robots.txt - no cache
    location = /robots.txt {
        access_log off;
        log_not_found off;
        expires 1d;
    }

    # Sitemap - short cache
    location = /sitemap.xml {
        access_log off;
        expires 1h;
    }
}
